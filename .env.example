# Anthropic API key — https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-...

# Path to the SQLite file the app reads and writes.
# A plain filesystem path, not a file: URL. Defaults to ./data/notegenius.db
DATABASE_URL=./data/notegenius.db

# Required private owner access; never commit the actual password.
NOTEGENIUS_USERNAME=admin
NOTEGENIUS_PASSWORD=
# For a remote HTTPS deployment only, set the exact public origin.
# NOTEGENIUS_ORIGIN=https://notes.example.com
